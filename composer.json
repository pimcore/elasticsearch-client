{
  "name": "pimcore/elasticsearch-client",
  "license": "proprietary",
  "type": "symfony-bundle",
  "config": {
    "sort-packages": true
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "pimcore/pimcore": "^2026.1",
    "elasticsearch/elasticsearch": "^8.12",
    "psr/log": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Pimcore\\Bundle\\ElasticsearchClientBundle\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-2026.x": "2026.3.x-dev"
    }
  }
}
